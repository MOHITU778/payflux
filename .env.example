# Copy to .env before `docker compose up`.
# Both secrets must be at least 32 characters — the config layer refuses to
# start otherwise, which is deliberate: a short JWT secret is a trivially
# brute-forceable one.
JWT_SECRET=replace-with-a-real-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-char-secret

# ─── Host port mappings ─────────────────────────────────────────────────────
# Override any of these if the default is already taken on your machine.
API_PORT=4000
CONSOLE_PORT=8080
MONGO_PORT=27017
REDIS_PORT_HOST=6379
STOREFRONT_PORT=8081
