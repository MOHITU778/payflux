# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=15000

# ─── Datastores ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/payflux
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too-in-production-32-characters
JWT_REFRESH_TTL=7d
PASSWORD_SCRYPT_COST=16384

# ─── Security ───────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:8080
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
PAYMENT_RATE_LIMIT_MAX=60

# ─── Idempotency & Locking ──────────────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=86400
LOCK_TTL_MS=10000
LOCK_RETRY_COUNT=5
LOCK_RETRY_DELAY_MS=200

# ─── Webhooks ───────────────────────────────────────────────────────────────
WEBHOOK_SIGNATURE_HEADER=x-payflux-signature
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_MS=8000

# ─── Fraud engine ───────────────────────────────────────────────────────────
FRAUD_BLOCK_THRESHOLD=80
FRAUD_REVIEW_THRESHOLD=50
FRAUD_HIGH_AMOUNT_MINOR=50000000
FRAUD_VELOCITY_WINDOW_SECONDS=300
FRAUD_VELOCITY_MAX_ATTEMPTS=10

# ─── Circuit breaker ────────────────────────────────────────────────────────
BREAKER_FAILURE_THRESHOLD=5
BREAKER_SUCCESS_THRESHOLD=2
BREAKER_TIMEOUT_MS=30000

# ─── Settlement ─────────────────────────────────────────────────────────────
SETTLEMENT_CRON=0 */6 * * *
SETTLEMENT_HOLD_HOURS=24
PLATFORM_FEE_BPS=200
ENABLE_SCHEDULERS=true

# ─── Acquirer simulator ─────────────────────────────────────────────────────
ACQUIRER_LATENCY_MS=120
ACQUIRER_FAILURE_RATE=0.08
